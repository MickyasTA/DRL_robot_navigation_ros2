<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>td3</name>
  <version>1.0.0</version>
  <description>
    TD3 deep-reinforcement-learning agent for goal-driven autonomous exploration
    and collision avoidance of a mobile robot in ROS 2 and Gazebo, with live SLAM
    mapping.
  </description>
  <maintainer email="tamirumickyas@gmail.com">Mickyas Tamiru Asfaw</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/MickyasTA/DRL_robot_navigation_ros2</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>gazebo_ros_pkgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>

</package>
